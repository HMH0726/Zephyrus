/ {
    aliases {
        usbd0 = &zephyr_udc0;
    };
	
    buttons {
        compatible = "gpio-keys";
        
        /* 頻道切換按鈕 (D3) */
        switch_btn: button_0 {
            gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Channel Switch Button";
        };

        /* 全清除按鈕 (D6) */
        clear_btn: button_1 {
            gpios = <&gpio1 11 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Clear All Bonds Button";
        };

        /* 【新增】硬體健檢與核彈重置按鈕 (D4) */
        diag_btn: button_2 {
            gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Diagnostic & Factory Reset Button";
        };
    };
	
};

&zephyr_udc0 {
    status = "okay";
    cdc_ncm_0: cdc_ncm_0 {
        compatible = "zephyr,cdc-ncm-ethernet";
        zephyr,random-mac-address; 
        
        /* 🚀 換成你專屬的 02 開頭虛擬 MAC */
        remote-mac-address = "02badc0ffee0"; 
        
        status = "okay";
    };
};