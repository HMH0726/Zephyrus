/*
 * XIAO nRF52840 / nRF52840 Plus test wiring.
 * All buttons are active-low: connect the selected XIAO pin to GND.
 * Adjust the GPIO numbers here if your Plus board package maps D pins differently.
 */
/ {
	aliases {
		mx-next = &mx_next_button;
		mx-left = &mx_left_button;
		mx-right = &mx_right_button;
		mx-middle = &mx_middle_button;
		mx-wheel-up = &mx_wheel_up_button;
		mx-wheel-down = &mx_wheel_down_button;
	};

	mx_buttons: mx_buttons {
		compatible = "gpio-keys";

		mx_next_button: mx_next_button {
			label = "MX channel next";
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* XIAO D0 */
		};

		mx_left_button: mx_left_button {
			label = "MX left button";
			gpios = <&gpio0 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* XIAO D1 */
		};

		mx_right_button: mx_right_button {
			label = "MX right button";
			gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* XIAO D2 */
		};

		mx_middle_button: mx_middle_button {
			label = "MX middle button";
			gpios = <&gpio0 29 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* XIAO D3 */
		};

		mx_wheel_up_button: mx_wheel_up_button {
			label = "MX wheel up";
			gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* XIAO D4 */
		};

		mx_wheel_down_button: mx_wheel_down_button {
			label = "MX wheel down";
			gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;  /* XIAO D5 */
		};
	};
};
