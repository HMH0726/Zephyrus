/*
 * Devicetree overlay: channel-switch button + status LED.
 *
 * XIAO nRF52840 D-pin -> nRF52840 GPIO mapping used below:
 *   D2 -> P0.28  (channel switch button, pulled up, active low)
 *   D3 -> P0.29  (status LED, active high)
 *
 * If your board revision / wiring differs, just change the pin numbers.
 * Some newer Zephyr board files expose an "xiao_d" gpio nexus so you can
 * write `<&xiao_d 2 ...>` instead of `<&gpio0 28 ...>` - either form is
 * fine, use whichever your Zephyr version supports.
 */

/ {
	buttons {
		compatible = "gpio-keys";
		channel_button: channel_button {
			gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Channel Switch Button (D2)";
		};
	};

	leds {
		compatible = "gpio-leds";
		status_led: status_led {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "Status LED (D3)";
		};
	};

	aliases {
		sw0 = &channel_button;
		led0 = &status_led;
	};
};
