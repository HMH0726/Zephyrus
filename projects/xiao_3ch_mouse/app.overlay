/*
 * 切換頻道用的實體按鈕。
 *
 * XIAO nRF52840 板子本身沒有可用的使用者按鈕（只有 reset），
 * 所以這裡假設你自己外接一顆按鈕到 P0.02（腳位隨你配線調整）。
 *
 * 接法：按鈕一端接此 GPIO，另一端接 GND，
 *       靠 GPIO_PULL_UP + GPIO_ACTIVE_LOW 偵測「按下」。
 *
 * 请依照你实际接线的针脚，修改下面的 "gpio0 2" 这两个数字。
 */

/ {
	aliases {
		ch-switch = &ch_switch_btn;
	};

	buttons {
		compatible = "gpio-keys";
		ch_switch_btn: ch_switch_btn {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Channel switch button";
		};
	};
};
